# Copy this file to .env and fill in your key. .env is gitignored.

# Required: your Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=data/chroma
SQLITE_PATH=data/enterprise.db
TOP_K=4
MIN_SIMILARITY=0.35
LOG_LEVEL=INFO
